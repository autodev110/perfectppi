{
  "name": "perfectppi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "npm run test:unit",
    "test:unit": "node --test \"tests/unit/*.test.mts\"",
    "test:db": "psql \"$TEST_DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/partner_integration.test.sql && psql \"$TEST_DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/role_switching.test.sql",
    "test:api": "next build && node --test tests/api/partner-api.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1021.0",
    "@aws-sdk/s3-request-presigner": "^3.1021.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.49.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "15.5.22",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "stripe": "^22.0.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-next": "15.5.22",
    "postcss": "^8.5.18",
    "tailwindcss": "^4.1.4",
    "tw-animate-css": "^1.2.8",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "overrides": {
      "fast-xml-builder@<1.1.7": "1.1.7",
      "fast-xml-parser@<5.7.0": "5.7.0",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.23": "8.5.26",
      "sharp@<0.35.0": "0.35.3",
      "ws@<8.21.0": "8.21.0"
    }
  }
}
