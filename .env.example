# ============================================================================
# Perfect PPI — environment
#
# Copy to .env.local for development, or set these in your hosting provider.
# Every variable below is read somewhere in src/; nothing here is decorative.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle. Everything else is
# server-only and must never appear in client code.
# ============================================================================

# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Bypasses RLS. Server-only — never expose, never import into a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Site ───────────────────────────────────────────────────────────────────
# Builds the deep link returned to DealerSpace and the account-linking URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── AI (report + VSC generation) ───────────────────────────────────────────
# Either one works; GEMINI_PERFECTPPI takes precedence.
GEMINI_PERFECTPPI=your-gemini-api-key
# GEMINI_API_KEY=

# ─── Cloudflare R2 ──────────────────────────────────────────────────────────
# One set of credentials, two buckets with different exposure.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Public bucket: vehicle photos and inspection media served to browsers.
R2_BUCKET_NAME=perfectppi-media
R2_PUBLIC_URL=https://your-r2-custom-domain.com

# Private bucket: inspection reports and VSC determinations. Must have NO
# public access and NO custom domain — these are served only through
# authenticated routes. Report generation refuses to run without it.
R2_PRIVATE_BUCKET_NAME=perfectppi-private-artifacts

# ─── DealerSpace partner integration ────────────────────────────────────────
# AES-256-GCM key encrypting each connection's webhook signing secret at rest.
# Must decode to exactly 32 bytes:  openssl rand -base64 32
# Connections cannot be created without it. This is Perfect PPI's own key and is
# unrelated to DealerSpace's PERFECTPPI_CREDENTIAL_ENCRYPTION_KEY.
PARTNER_SECRET_ENCRYPTION_KEY=

# Authenticates the background workers that generate reports and deliver
# webhooks. Vercel Cron sends this as a bearer token; without it the worker
# endpoints refuse to run at all.  openssl rand -hex 32
CRON_SECRET=

# Optional second credential for triggering a worker by hand via the
# x-worker-secret header. Defaults to CRON_SECRET when unset.
# WORKER_SECRET=

# DEVELOPMENT ONLY. Allows http:// and loopback webhook/callback URLs so a
# local DealerSpace can be registered. Never set this in production — it
# disables part of the SSRF guard.
# PARTNER_ALLOW_INSECURE_CALLBACKS=true

# ─── Payments (existing features, not used by the integration) ──────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Contracts (existing features, not used by the integration) ─────────────
DOCUSEAL_API_URL=
DOCUSEAL_API_KEY=
DOCUSEAL_PUBLIC_URL=
DOCUSEAL_WEBHOOK_SECRET=
DOCUSEAL_WARRANTY_TEMPLATE_ID=
DOCUSEAL_CUSTOMER_ROLE=
# Used only by the DocuSeal webhook route, not by artifact storage.
R2_ACCOUNT_ID=

# ─── iOS push (existing features, not used by the integration) ──────────────
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_AUTH_KEY=
APNS_TOPIC=
APPLE_APP_ID=
