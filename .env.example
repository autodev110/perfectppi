# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public application origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Report generation
GEMINI_PERFECTPPI=
# GEMINI_API_KEY may be used as a fallback.

# DealerSpace partner integration
# Generate with: openssl rand -base64 32
PARTNER_SECRET_ENCRYPTION_KEY=
CRON_SECRET=
# Optional manual worker credential; defaults to CRON_SECRET.
WORKER_SECRET=

# Cloudflare R2 credentials shared by both bucket clients
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Existing media bucket. It may have a public/custom domain.
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Inspection and VSC deliverables. This bucket must not have a public domain.
R2_PRIVATE_BUCKET_NAME=perfectppi-private-artifacts

# Local development only. Never enable in production.
PARTNER_ALLOW_INSECURE_CALLBACKS=false
